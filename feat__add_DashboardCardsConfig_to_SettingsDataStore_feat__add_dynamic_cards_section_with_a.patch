+package com.osscabinet.ossWallet.domain.model.settings
+
+import com.osscabinet.ossWallet.domain.model.timeline.TimelineRange
+import java.util.UUID
+
+/**
+ * Default configurations for dashboard cards
+ * Used to initialize the dashboard with standard card instances
+ */
+object CardConfigDefaults {
+    
+    /**
+     * Creates the default set of dashboard cards
+     */
+    fun createDefaultCards(): List<CardConfig> {
+        return listOf(
+            NetWorthCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 0
+            ),
+            CurrencyBalancesCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 1
+            ),
+            CashFlowCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 2
+            ),
+            AccountsCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 3
+            ),
+            BudgetsCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 4
+            )
+        )
+    }
+    
+    /**
+     * Creates a new card instance of the specified type
+     */
+    fun createCardInstance(cardType: String, order: Int): CardConfig {
+        return when (cardType) {
+            "net_worth" -> NetWorthCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = order
+            )
+            "currency_balances" -> CurrencyBalancesCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = order
+            )
+            "cash_flow" -> CashFlowCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = order
+            )
+            "accounts" -> AccountsCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = order
+            )
+            "budgets" -> BudgetsCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = order
+            )
+            else -> throw IllegalArgumentException("Unknown card type: $cardType")
+        }
+    }
+    
+    /**
+     * Migrates old DashboardSettings to new DashboardCardsConfig
+     */
+    fun migrateFromOldSettings(
+        netWorthSettings: com.osscabinet.ossWallet.domain.model.settings.NetWorthSettings,
+        currencyBalancesSettings: com.osscabinet.ossWallet.ui.dashboard.components.CurrencyBalancesSettings,
+        cashFlowSettings: com.osscabinet.ossWallet.ui.dashboard.components.CashFlowSettings,
+        accountsSettings: com.osscabinet.ossWallet.ui.dashboard.components.AccountsSectionSettings,
+        budgetSettings: com.osscabinet.ossWallet.ui.dashboard.components.BudgetSettings
+    ): List<CardConfig> {
+        return listOf(
+            NetWorthCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 0,
+                fontSize = netWorthSettings.fontSize,
+                timelineRange = netWorthSettings.timelineRange,
+                profileId = netWorthSettings.profileId,
+                selectedAccountIds = netWorthSettings.selectedAccountIds
+            ),
+            CurrencyBalancesCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 1,
+                layout = currencyBalancesSettings.layout,
+                showBaseConversion = currencyBalancesSettings.showBaseConversion,
+                timelineRange = currencyBalancesSettings.timelineRange
+            ),
+            CashFlowCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 2,
+                showBaseConversion = cashFlowSettings.showBaseConversion,
+                timelineRange = cashFlowSettings.timelineRange
+            ),
+            AccountsCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 3,
+                layout = accountsSettings.layout,
+                gridColumns = accountsSettings.gridColumns,
+                showAddAccountCard = accountsSettings.showAddAccountCard,
+                timelineRange = accountsSettings.timelineRange
+            ),
+            BudgetsCardConfig(
+                cardId = UUID.randomUUID().toString(),
+                order = 4,
+                showProgressLabels = budgetSettings.showProgressLabels
+            )
+        )
+    }
+}
