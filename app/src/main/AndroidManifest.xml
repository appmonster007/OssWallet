            android:name=".widget.CashFlowWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

