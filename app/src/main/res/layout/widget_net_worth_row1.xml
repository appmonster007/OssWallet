<?xml version="1.0" encoding="utf-8"?>
<!-- Shared "row 1" fragment — the amount and comparison line used by EVERY NetWorth widget
     tier, via <include>. Not a standalone widget layout: root is <merge>, so including it
     inside a vertical LinearLayout drops these elements in as direct siblings of whatever else
     that tier adds below (see widget_net_worth_micro/strip/card.xml). Keeping this in one file
     is what makes "row 1" actually identical everywhere instead of hand-copied near-matches
     drifting apart.

     No header row — settings is reached via the launcher's long-press "Edit widget" (see
     net_worth_widget_info*.xml's android:configure), not an in-widget gear. The amount wrapper
     carries its own 12dp horizontal inset plus a 10dp top inset (there's no header above it to
     supply one), and the comparison pill gets a matching start margin instead of being wrapped,
     since it's already wrap_content.

     Same structure as every cell (see widget_net_worth_strip/card.xml): amount (vertically
     centered, right-aligned, now filling the FULL row since nothing above it shares the space)
     / comparison-% (bottom-left) — with the amount wrapper taking layout_weight="1".

     Font families mirror NetWorthCard.kt's own AppTextStyles usage: titles/amounts
     (cardSectionTitle, heroAmountLarge, transactionAmount — all displayFamily) use
     @font/manrope; overlines/comparison-% (sectionOverline, metaLabel — monoFamily) use
     @font/jetbrains_mono. Same split applied to every cell in strip/card.xml. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp">

        <TextView
                android:id="@+id/tv_nw_row1_amount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:fontFamily="@font/manrope"
                android:textColor="@color/widget_on_surface"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="$12,340.55"
                tools:text="$12,340.55" />

    </LinearLayout>

    <TextView
            android:id="@+id/tv_nw_row1_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_netflow_pill_bg"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/widget_accent"
            android:textSize="8sp"
            android:textStyle="bold"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="▲ +4.2%"
            tools:text="▲ +4.2%" />

</merge>
