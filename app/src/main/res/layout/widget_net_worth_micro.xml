<?xml version="1.0" encoding="utf-8"?>
<!-- Shortest NetWorth widget layout (minHeight < 110dp — true content minimum is ~40dp per the
     70dp*n-30dp cell formula), pushed via RemoteViews from NetWorthRemoteViewsRenderer. Just
     widget_net_worth_row1.xml (amount + comparison pill) — the exact same block every taller
     tier starts with.

     Root is unpadded except for a bottom inset — horizontal/top padding live on row1's own
     amount wrapper (see widget_net_worth_row1.xml). Must match strip.xml/card.xml exactly — all
     three tiers share one frame. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/ll_widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingBottom="12dp">

    <include layout="@layout/widget_net_worth_row1" />

</LinearLayout>
