<?xml version="1.0" encoding="utf-8"?>
<!-- Budgets widget — 4x2 "2 rows, no sub-line" tier. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_inner_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/tv_budgets_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Budgets"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/tv_budgets_header_comparison"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="vs last period"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ll_budget_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/tv_budget_row1_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_budget_row1_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp">
            <View android:id="@+id/v_budget_row1_track" android:layout_width="match_parent" android:layout_height="6dp" android:background="@color/widget_row_chip_bg" />
            <View android:id="@+id/v_budget_row1_fill" android:layout_width="match_parent" android:layout_height="6dp" android:layout_gravity="start" android:background="@color/widget_accent_teal" />
        </FrameLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/widget_divider_soft" />

    <LinearLayout android:id="@+id/ll_budget_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/tv_budget_row2_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_budget_row2_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp">
            <View android:id="@+id/v_budget_row2_track" android:layout_width="match_parent" android:layout_height="6dp" android:background="@color/widget_row_chip_bg" />
            <View android:id="@+id/v_budget_row2_fill" android:layout_width="match_parent" android:layout_height="6dp" android:layout_gravity="start" android:background="@color/widget_accent_teal" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
