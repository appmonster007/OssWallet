<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Cash Flow widget tier (short heights), pushed via RemoteViews from
     CashFlowRemoteViewsRenderer.renderCompact(). Target model: period label, net% trend
     chip, 3-col grid (Income/Expenses/Net flow), a summary chip row (In/Out/Transfers),
     and a caption — see docs/card-data-summary.md CASH_FLOW section. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

        <TextView
                android:id="@+id/tv_cf_compact_period"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="This Month" />

        <TextView
                android:id="@+id/tv_cf_compact_trend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_accent_teal"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="▲ +4.2%" />

    </LinearLayout>

    <!-- 3-col grid: Income / Expenses / Net flow -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INCOME" android:textColor="@color/widget_text_muted" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_cf_compact_income" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_income_color" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="5,000.00 $" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXPENSES" android:textColor="@color/widget_text_muted" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_cf_compact_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_expense_color" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="3,500.00 $" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NET FLOW" android:textColor="@color/widget_text_muted" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_cf_compact_netflow" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_accent_teal" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="1,500.00 $" />
        </LinearLayout>

    </LinearLayout>

    <!-- Summary chip row: In / Out / Transfers -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_metric_tile_bg"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:baselineAligned="false">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="In " android:textColor="@color/widget_text_muted" android:textSize="8sp" />
            <TextView android:id="@+id/tv_cf_compact_chip_in" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text_primary" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="5,500.00 $" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Out " android:textColor="@color/widget_text_muted" android:textSize="8sp" />
            <TextView android:id="@+id/tv_cf_compact_chip_out" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text_primary" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="3,700.00 $" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xfer " android:textColor="@color/widget_text_muted" android:textSize="8sp" />
            <TextView android:id="@+id/tv_cf_compact_chip_transfers" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text_primary" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="200.00 $" />
        </LinearLayout>

    </LinearLayout>

    <TextView
            android:id="@+id/tv_cf_compact_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/widget_text_muted"
            android:textSize="7sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Amounts in USD" />

</LinearLayout>
