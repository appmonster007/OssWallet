                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Transport" />

                <TextView
                        android:id="@+id/tv_rt_row3_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:textSize="6sp"
                        android:textStyle="bold"
                        android:maxWidth="56dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />

            </LinearLayout>

            <TextView
                    android:id="@+id/tv_rt_row3_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_subtle"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Metro card top-up" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/tv_rt_row3_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="-15.00"
                    tools:textColor="@color/widget_expense_color" />

            <TextView
                    android:id="@+id/tv_rt_row3_amount_base"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="7sp"
                    android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Visibility mirrors ll_rt_row4 — only shown at height >= 200dp. -->
    <FrameLayout
            android:id="@+id/v_rt_divider3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_outline" />

    <!-- Row 4 -->
    <TextView
            android:id="@+id/tv_rt_row4_datecap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_text_muted"
            android:textSize="7sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

    <LinearLayout
            android:id="@+id/ll_rt_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

        <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

            <ImageView
                    android:id="@+id/iv_rt_row4_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/widget_circle_badge"
                    android:contentDescription="@null"
                    tools:ignore="ContentDescription" />

            <TextView
                    android:id="@+id/tv_rt_row4_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="G" />
        </FrameLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <TextView
                        android:id="@+id/tv_rt_row4_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Groceries" />

                <TextView
                        android:id="@+id/tv_rt_row4_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:textSize="6sp"
                        android:textStyle="bold"
                        android:maxWidth="56dp"
                        android:maxLines="1"
                        android:ellipsize="end"
