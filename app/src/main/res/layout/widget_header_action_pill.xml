<?xml version="1.0" encoding="utf-8"?>
<!-- A single action pill for widget_header_row.xml's ll_widget_header_extra slot — inflated as
     its own RemoteViews and added via RemoteViews.addView() by a renderer that needs one (e.g.
     RecentActivitiesRemoteViewsRenderer's "VIEW ALL"). Net Worth doesn't use this; its header
     has no extra action. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/tv_header_action_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_netflow_pill_bg"
        android:fontFamily="@font/jetbrains_mono"
        android:textColor="@color/widget_accent"
        android:textSize="8sp"
        android:textStyle="bold"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp" />
