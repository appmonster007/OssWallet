<?xml version="1.0" encoding="utf-8"?>
<!-- Short-height NetWorth widget layout (minHeight < 100dp), pushed via
     RemoteViews from NetWorthRemoteViewsRenderer. Simplification vs the old
     Glance version: no width-based 3/4/5-column strip variants or INC/EXP
     badges in strip mode — just title/change on one line, amount below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NET WORTH"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="8sp"
                android:textStyle="bold" />

        <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        <TextView
                android:id="@+id/tv_nw_strip_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_accent"
                android:textSize="8sp"
                tools:text="+4.2%" />

    </LinearLayout>

    <TextView
            android:id="@+id/tv_nw_strip_net_worth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="12,340.55 $" />

</LinearLayout>
