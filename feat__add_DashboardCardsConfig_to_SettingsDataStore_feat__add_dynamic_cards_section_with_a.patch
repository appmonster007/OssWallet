+                    accounts = state.accounts,
+                    accountStats = state.accountStats,
+                    budgets = emptyList(), // TODO: Pass budgets
+                    baseCurrency = state.baseCurrency,
+                    precision = state.decimalPrecision,
+                    exchangeRates = state.exchangeRates
+                )
+                
+                CardRenderer(
+                    config = cardConfig,
+                    data = cardData,
+                    modifier = Modifier.fillMaxWidth(),
+                    onConfigUpdate = { updatedConfig ->
+                        cardManagerViewModel.updateCard(cardConfig.cardId) { updatedConfig }
+                    },
+                    onRemove = {
+                        cardManagerViewModel.removeCard(cardConfig.cardId)
+                    }
+                )
+            }
+        }
+    }
+    
+    if (showAddCardDialog) {
+        CardTypeSelectionDialog(
