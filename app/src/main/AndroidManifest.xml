            android:name=".widget.RecentTransactionsWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BudgetsWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

