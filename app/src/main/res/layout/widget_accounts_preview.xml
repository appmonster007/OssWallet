        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" android:text="Cash Wallet" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_negative" android:textSize="8sp" android:text="-$171.50 · This Month" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/manrope" android:textColor="@color/widget_negative" android:textSize="13sp" android:textStyle="bold" android:text="-$2,775.35" />
