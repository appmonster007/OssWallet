<?xml version="1.0" encoding="utf-8"?>
<!-- Recent Activities widget's real content. No fixed tiers like Net Worth — it's a true
     scrolling ListView (RecentActivitiesRemoteViewsService), so no upper height bound.

     Header is the shared widget_header_row.xml shell (see that file) — its
     ll_widget_header_extra slot gets the "VIEW ALL" pill added via RemoteViews.addView() in
     RecentActivitiesRemoteViewsRenderer, since Net Worth's header has no equivalent action.
     ll_ra_empty is the ListView's empty view (RemoteViews.setEmptyView) — must stay a sibling
     of it for that to work. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/ll_widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical">

    <include layout="@layout/widget_header_row" />

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <ListView
                android:id="@+id/lv_ra_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:paddingBottom="12dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none" />

        <LinearLayout
                android:id="@+id/ll_ra_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

            <ImageView
                    android:id="@+id/iv_ra_empty_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/widget_ic_history"
                    android:tint="@color/widget_outline"
                    android:contentDescription="@null" />

            <TextView
                    android:id="@+id/tv_ra_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:text="No recent activity" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
