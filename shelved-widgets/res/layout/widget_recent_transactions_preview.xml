<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview (android:previewLayout) — mirrors widget_recent_transactions_list.xml
     exactly: single layout at all sizes, circle avatars (per the circle-icons decision),
     Ledger-style hairline dividers between rows. Static app:tint per sample row stands in
     for the real per-transaction setColorFilter(categoryColor) RemoteViews does at runtime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <!-- Header -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:baselineAligned="false">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_activities_header"
                android:textColor="@color/widget_subtle"
                android:textSize="10sp"
                android:textStyle="bold" />

        <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_period_this_month"
                android:textColor="@color/widget_subtle"
                android:textSize="10sp" />
    </LinearLayout>

    <!-- Row 1: Food & Drinks -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

        <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

            <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/widget_circle_badge"
                    app:tint="@color/widget_negative"
                    android:contentDescription="@null" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="F"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_tx1_title"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_tx1_subtitle"
                    android:textColor="@color/widget_subtle"
                    android:textSize="8sp"
                    android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_tx1_amount"
                    android:textColor="@color/widget_expense_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_tx1_time"
                    android:textColor="@color/widget_subtle"
                    android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_outline" />

    <!-- Row 2: Salary -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

        <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

            <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/widget_circle_badge"
                    app:tint="@color/widget_positive"
                    android:contentDescription="@null" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_tx2_title"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_tx2_subtitle"
                    android:textColor="@color/widget_subtle"
                    android:textSize="8sp"
                    android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_tx2_amount"
                    android:textColor="@color/widget_income_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_tx2_time"
                    android:textColor="@color/widget_subtle"
                    android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_outline" />

    <!-- Row 3: Transport -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

        <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

            <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/widget_circle_badge"
                    app:tint="@color/widget_transfer"
                    android:contentDescription="@null" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="T"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transport"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Metro card top-up"
                    android:textColor="@color/widget_subtle"
                    android:textSize="8sp"
                    android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-15.00"
                    android:textColor="@color/widget_expense_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 days ago"
                    android:textColor="@color/widget_subtle"
                    android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
