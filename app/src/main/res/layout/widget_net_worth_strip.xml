<?xml version="1.0" encoding="utf-8"?>
<!-- Strip tier (110dp <= minHeight < 180dp), pushed via RemoteViews from
     NetWorthRemoteViewsRenderer. "Row 1" (widget_net_worth_row1.xml — header + amount) is the
     exact same block micro/card start with too. Below it: ONE row holding up to 4 cells side by
     side (cell1 | cell2 | cell3 | cell4) — not enough height at this tier to give cell3 its own
     row (that split starts at the card tier). cell4 only appears for Accounting + split
     transfers (Transfer Out, paired with cell3's Transfer In); NetWorthWidgetFetcher sets
     CELL4_VISIBLE="false" otherwise, and a GONE view doesn't count toward this row's
     layout_weight sum, so cell1-3 simply reclaim cell4's share when it's hidden.

     Each cell is label (top-left) / value (vertically centered, right-aligned) / comparison-%
     (bottom-left) — three children in document order inside a vertical LinearLayout, with only
     the middle (value) taking layout_weight="1": label and cmp size to their own content and
     stay pinned top/bottom, while value expands to fill whatever's left between them and
     centers itself within that span via its own android:gravity="center_vertical|end". Label and
     comparison-% use @font/jetbrains_mono (matches NetWorthCard.kt's sectionOverline/metaLabel);
     value uses @font/manrope (matches its transactionAmount) — same split as row1.xml.

     Both rows get layout_weight="1" — row 1 included, wrapped in its own container so it's a
     single flex item — so the header+amount block and the cell row each get exactly half the
     available height, not "row 1 sized to its content, cells get whatever's left".

     Root padding (12dp, all sides) must match micro.xml/card.xml exactly — all three tiers
     share one frame, not three independently-tuned ones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="top">
        <include layout="@layout/widget_net_worth_row1" />
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

        <LinearLayout
                android:id="@+id/ll_nw_cell1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_metric_tile_bg"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
            <TextView
                    android:id="@+id/tv_nw_cell1_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Inflow" />
            <TextView
                    android:id="@+id/tv_nw_cell1_value"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical|end"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="5,000.00 $" />
            <TextView
                    android:id="@+id/tv_nw_cell1_cmp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="▲6.0%" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/ll_nw_cell2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_metric_tile_bg"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
            <TextView
                    android:id="@+id/tv_nw_cell2_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Outflow" />
            <TextView
                    android:id="@+id/tv_nw_cell2_value"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical|end"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="-3,200.00 $" />
            <TextView
                    android:id="@+id/tv_nw_cell2_cmp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="▼1.4%" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/ll_nw_cell3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_netflow_pill_bg"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
            <TextView
                    android:id="@+id/tv_nw_cell3_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/widget_accent"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Net flow" />
            <TextView
                    android:id="@+id/tv_nw_cell3_value"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical|end"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="3,600.00 $" />
            <TextView
                    android:id="@+id/tv_nw_cell3_cmp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/widget_accent"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="▲12.3%" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/ll_nw_cell4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_metric_tile_bg"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
            <TextView
                    android:id="@+id/tv_nw_cell4_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Transfer Out" />
            <TextView
                    android:id="@+id/tv_nw_cell4_value"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical|end"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="-1,100.00 $" />
            <TextView
                    android:id="@+id/tv_nw_cell4_cmp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="▼1.4%" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
