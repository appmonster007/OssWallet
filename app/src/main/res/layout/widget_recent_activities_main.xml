<?xml version="1.0" encoding="utf-8"?>
<!-- Recent Activities widget's real content. No fixed tiers like Net Worth — it's a true
     scrolling ListView (RecentActivitiesRemoteViewsService), so no upper height bound.

     No header row — settings is reached via the launcher's long-press "Edit widget"
     (recent_activities_widget_info.xml's android:configure). "VIEW ALL" now lives in a footer
     row below the list instead (tv_ra_view_all), bound by RecentActivitiesRemoteViewsRenderer.
     ll_ra_empty is the ListView's empty view (RemoteViews.setEmptyView) — must stay a sibling
     of it for that to work. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/ll_widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical">

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <ListView
                android:id="@+id/lv_ra_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:paddingBottom="8dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none" />

        <LinearLayout
                android:id="@+id/ll_ra_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

            <ImageView
                    android:id="@+id/iv_ra_empty_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/widget_ic_history"
                    android:tint="@color/widget_outline"
                    android:contentDescription="@null" />

            <TextView
                    android:id="@+id/tv_ra_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:text="No recent activity" />

        </LinearLayout>

    </FrameLayout>

    <FrameLayout
            android:id="@+id/v_ra_footer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_outline" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

        <TextView
                android:id="@+id/tv_ra_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_netflow_pill_bg"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/widget_accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="VIEW ALL"
                tools:text="VIEW ALL" />

    </LinearLayout>

</LinearLayout>
