            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tag_upset_plot_widget_info" />
        </receiver>

        <!-- Not an AppWidgetProvider — a plain exported=false action receiver that Confirm/Skip
             PendingIntents on the Planned Payments widget target directly (see
             PlannedPaymentsWidgetActionReceiver / PlannedPaymentsRemoteViewsRenderer). -->
        <receiver
            android:name=".widget.PlannedPaymentsWidgetActionReceiver"
            android:exported="false" />

        <activity
            android:name=".widget.NetWorthWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

