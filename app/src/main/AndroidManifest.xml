<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".OssWalletApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OssWallet">

        <!-- OssWalletApp implements Configuration.Provider (on-demand WorkManager init),
             so the default WorkManagerInitializer must be removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.screens.dashboard.quickadd.QuickAddActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.App.QuickAddShortcut"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.screens.shortcut.ShortcutConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet" />

        <!-- NetWorth homescreen widget — three provider registrations (Compact/Trend/Card) so
             the system widget picker shows each tier's own preview thumbnail as a separate
             choice, instead of one dummy static preview. All three share the same fetcher/
             renderer/prefs store/config activity and are each freely resizable across the
             full range after placement — only the starting size and picker thumbnail differ. -->
        <receiver
            android:name=".widget.NetWorthWidgetProviderMicro"
            android:label="@string/widget_net_worth_micro_label"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/net_worth_widget_info_micro" />
        </receiver>

        <receiver
            android:name=".widget.NetWorthWidgetProvider"
            android:label="@string/widget_net_worth_strip_label"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/net_worth_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NetWorthWidgetProviderCard"
            android:label="@string/widget_net_worth_card_label"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/net_worth_widget_info_card" />
        </receiver>

        <!-- Cash Flow and every Phase 2/3 widget's <receiver>/<activity> entries were removed
             here when those widgets were shelved (2026-10-08) — see shelved-widgets/README.md
             and shelved-widgets/restore.patch at the repo root. -->

        <receiver
            android:name=".widget.RecentActivitiesWidgetProvider"
            android:label="@string/widget_recent_activities_label"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_activities_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.AccountsWidgetProvider"
            android:label="@string/widget_accounts_label"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/accounts_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BudgetsWidgetProvider"
            android:label="@string/widget_budgets_label"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/budgets_widget_info" />
        </receiver>

        <activity
            android:name=".widget.AccountsWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.BudgetsWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.NetWorthWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.RecentActivitiesWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OssWallet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Backs RecentActivitiesWidgetProvider's ListView — BIND_REMOTEVIEWS is required for
             any RemoteViewsService a widget's RemoteViews references via setRemoteAdapter, and
             exported must stay false (the system binds to it on the widget host's behalf; this
             is never meant to be reachable by other apps). -->
        <service
            android:name=".widget.RecentActivitiesRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Back the Budgets and Accounts widgets' ListViews; BIND_REMOTEVIEWS is required and exported
             must stay false (the system binds to them on the widget host's behalf). -->
        <service
            android:name=".widget.BudgetsRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".widget.AccountsRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Snooze / Mark paid buttons on reminder notifications. Only our own PendingIntents target it. -->
        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />

        <service
            android:name=".service.WebServerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- AI assistants call OssWallet through this service (Android 16+). Every function ships disabled and
             is switched on from Settings → Security & Privacy; each one also refuses to run while the app is locked. -->
        <service
            android:name=".appfunctions.OssWalletAppFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions"
                android:value="app_functions.xml" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="osswallet_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
                <action android:name="android.app.appfunctions.action.APP_FUNCTION_SERVICE" />
                <action android:name="android.intent.action.APP_FUNCTION" />
            </intent-filter>
        </service>

        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_function_metadata" />
    </application>

</manifest>
