<?xml version="1.0" encoding="utf-8"?>
<!-- Taller NetWorth widget layout (minHeight >= 100dp), pushed via
     RemoteViews from NetWorthRemoteViewsRenderer. Ledger style, matched to
     NetWorthCard's actual internal structure: hero amount, a two-tone trend
     line, a DASHED divider (aeonDashedTopRule equivalent), then an INC/EXP
     row with a real vertical separator between columns. No header icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NET WORTH"
            android:textColor="@color/widget_subtle"
            android:textSize="8sp"
            android:textStyle="bold" />

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/tv_nw_card_net_worth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="125,000.50 $" />

            <LinearLayout
                    android:id="@+id/ll_nw_card_trend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <TextView
                        android:id="@+id/tv_nw_card_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_positive"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="&#9650; +2.5%" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="VS PRIOR PERIOD"
                        android:textColor="@color/widget_subtle"
                        android:textSize="8sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Dashed divider -->
    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/widget_dashed_divider" />

    <!-- INC / EXP flow row with a real vertical separator between columns. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:paddingTop="6dp">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INC"
                    android:textColor="@color/widget_subtle"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/tv_nw_card_inc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_income_color"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="5,000.00 $" />

        </LinearLayout>

        <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/widget_outline" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXP"
                    android:textColor="@color/widget_subtle"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/tv_nw_card_exp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_expense_color"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="3,200.00 $" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
