<?xml version="1.0" encoding="utf-8"?>
<!-- Picker-only overlay for the Net Worth previews. The previews <include> the live tier layouts,
     whose header icon and title (widget_header_row.xml) are only bound at runtime by
     WidgetHeader.bindIcon / the renderer — so in the picker they render empty. This is drawn on
     top of that empty header with the same insets (12dp start, 8dp top, 16dp icon, 6dp gap) so
     the preview shows what the live widget does by default (Accounting perspective). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp">

    <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_pv_ic_net_worth"
            android:contentDescription="@null" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:gravity="center_vertical"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="NET WORTH · ACCOUNTING" />

</LinearLayout>
