+package com.osscabinet.ossWallet.ui.dashboard
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.osscabinet.ossWallet.data.local.SettingsDataStore
+import com.osscabinet.ossWallet.data.local.DashboardCardsConfig
+import com.osscabinet.ossWallet.domain.model.settings.CardConfig
+import com.osscabinet.ossWallet.domain.model.settings.CardConfigDefaults
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+/**
+ * ViewModel for managing dashboard card instances
+ * Handles adding, removing, and reordering cards
+ */
+class CardManagerViewModel(
+    private val settingsDataStore: SettingsDataStore
+) : ViewModel() {
+    
+    private val _cardsConfig = MutableStateFlow<DashboardCardsConfig>(DashboardCardsConfig())
+    val cardsConfig: StateFlow<DashboardCardsConfig> = _cardsConfig.asStateFlow()
+    
+    init {
+        viewModelScope.launch {
+            settingsDataStore.dashboardCardsConfig.collect { config ->
+                _cardsConfig.value = config
+            }
+        }
+    }
+    
+    /**
+     * Initializes the dashboard with default cards if none exist
+     */
+    fun initializeDefaultCards() {
+        viewModelScope.launch {
+            settingsDataStore.updateDashboardCardsConfig { config ->
+                if (config.cards.isEmpty()) {
+                    DashboardCardsConfig(cards = CardConfigDefaults.createDefaultCards())
+                } else {
+                    config
+                }
+            }
+        }
+    }
+    
+    /**
+     * Adds a new card instance of the specified type
+     */
+    fun addCard(cardType: String) {
+        viewModelScope.launch {
+            settingsDataStore.updateDashboardCardsConfig { config ->
+                val maxOrder = config.cards.maxOfOrNull { it.order } ?: -1
+                val newCard = CardConfigDefaults.createCardInstance(cardType, maxOrder + 1)
+                DashboardCardsConfig(cards = config.cards + newCard)
+            }
+        }
+    }
+    
+    /**
+     * Removes a card by its ID
+     */
+    fun removeCard(cardId: String) {
+        viewModelScope.launch {
+            settingsDataStore.updateDashboardCardsConfig { config ->
+                DashboardCardsConfig(cards = config.cards.filter { it.cardId != cardId })
+            }
+        }
+    }
+    
+    /**
+     * Updates a card's configuration
+     */
+    fun updateCard(cardId: String, update: (CardConfig) -> CardConfig) {
+        viewModelScope.launch {
+            settingsDataStore.updateDashboardCardsConfig { config ->
+                DashboardCardsConfig(cards = config.cards.map { card ->
+                    if (card.cardId == cardId) update(card) else card
+                })
+            }
+        }
+    }
+    
+    /**
+     * Reorders cards by swapping their order values
+     */
+    fun reorderCards(fromIndex: Int, toIndex: Int) {
+        viewModelScope.launch {
+            settingsDataStore.updateDashboardCardsConfig { config ->
+                val cards = config.cards.toMutableList()
+                if (fromIndex in cards.indices && toIndex in cards.indices) {
+                    val temp = cards[fromIndex]
+                    cards[fromIndex] = cards[toIndex]
+                    cards[toIndex] = temp
+                    
+                    // Update order values
+                    cards.forEachIndexed { index, card ->
+                        cards[index] = when (card) {
+                            is com.osscabinet.ossWallet.domain.model.settings.NetWorthCardConfig -> 
+                                card.copy(order = index)
+                            is com.osscabinet.ossWallet.domain.model.settings.CurrencyBalancesCardConfig -> 
+                                card.copy(order = index)
+                            is com.osscabinet.ossWallet.domain.model.settings.CashFlowCardConfig -> 
+                                card.copy(order = index)
+                            is com.osscabinet.ossWallet.domain.model.settings.AccountsCardConfig -> 
+                                card.copy(order = index)
+                            is com.osscabinet.ossWallet.domain.model.settings.BudgetsCardConfig -> 
+                                card.copy(order = index)
+                        }
+                    }
+                }
+                DashboardCardsConfig(cards = cards)
+            }
+        }
+    }
+    
+    /**
+     * Migrates old settings to the new card-based system
+     */
+    fun migrateFromOldSettings(
+        netWorthSettings: com.osscabinet.ossWallet.domain.model.settings.NetWorthSettings,
+        currencyBalancesSettings: com.osscabinet.ossWallet.ui.dashboard.components.CurrencyBalancesSettings,
+        cashFlowSettings: com.osscabinet.ossWallet.ui.dashboard.components.CashFlowSettings,
+        accountsSettings: com.osscabinet.ossWallet.ui.dashboard.components.AccountsSectionSettings,
+        budgetSettings: com.osscabinet.ossWallet.ui.dashboard.components.BudgetSettings
+    ) {
+        viewModelScope.launch {
+            settingsDataStore.updateDashboardCardsConfig { config ->
+                if (config.cards.isEmpty()) {
+                    DashboardCardsConfig(
+                        cards = CardConfigDefaults.migrateFromOldSettings(
+                            netWorthSettings,
+                            currencyBalancesSettings,
+                            cashFlowSettings,
+                            accountsSettings,
+                            budgetSettings
+                        )
+                    )
+                } else {
+                    config
+                }
+            }
+        }
+    }
+}
