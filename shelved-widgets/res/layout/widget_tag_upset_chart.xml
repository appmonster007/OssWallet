<?xml version="1.0" encoding="utf-8"?>
<!-- Tag UpSet Plot widget — 4x3 tier. Bar+dot-matrix bitmap (WidgetUpSetPlotRenderer) on the
     right, a legend naming each tag row (color + total) on the left. Tap-inert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_inner_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <TextView android:id="@+id/tv_tup_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/tv_tup_subheader" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="9sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="4dp">

        <LinearLayout android:layout_width="64dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/ll_tup_legend1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                <ImageView android:id="@+id/v_tup_legend1_dot" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/widget_circle_badge" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="4dp">
                    <TextView android:id="@+id/tv_tup_legend1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/tv_tup_legend1_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/ll_tup_legend2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                <ImageView android:id="@+id/v_tup_legend2_dot" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/widget_circle_badge" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="4dp">
                    <TextView android:id="@+id/tv_tup_legend2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/tv_tup_legend2_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/ll_tup_legend3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/v_tup_legend3_dot" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/widget_circle_badge" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="4dp">
                    <TextView android:id="@+id/tv_tup_legend3_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/tv_tup_legend3_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView android:id="@+id/iv_tup_chart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:scaleType="fitXY" />
    </LinearLayout>
</LinearLayout>
