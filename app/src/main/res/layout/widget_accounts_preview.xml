<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview for the Accounts widget picker thumbnail (android:previewLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="8dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_on_surface_variant" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.05" android:text="TOTAL BALANCE" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:textColor="@color/widget_on_surface" android:textSize="22sp" android:textStyle="bold" android:text="$9,565.20" />
    </LinearLayout>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_outline" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp">
        <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp">

            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.16"
                    android:src="@drawable/widget_oval_bg"
                    android:tint="#FF2196F3"
                    android:contentDescription="@null" />

            <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_pv_ic_acct_bank"
                    android:contentDescription="@null" />

        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" android:text="Everyday" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_positive" android:textSize="8sp" android:text="+$1,200.00 · This Month" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/manrope" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" android:text="$3,420.10" />
