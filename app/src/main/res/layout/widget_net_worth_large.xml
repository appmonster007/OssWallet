<?xml version="1.0" encoding="utf-8"?>
<!-- "Large" NetWorth widget tier (minHeight >= LARGE_HEIGHT_DP = 260dp), pushed via
     RemoteViews from NetWorthRemoteViewsRenderer.renderLarge(). Flat single-surface
     background using the theme-adaptive widget_surface/widget_on_surface/
     widget_on_surface_variant/widget_accent tokens. Header label+subtitle with an inert "+"
     add button, amount with a pill-styled comparison, then the SAME 3-cell row every tier
     from widget_net_worth_card.xml up uses (cell1/cell2 side by side + cell3 full width) —
     here with an added "vs {prior}" line per cell since there's room for it; a taller
     placement (4+ rows) uses this exact same layout, just with more breathing room inside the
     same flex:1 rows — there's no separate "even bigger" tier.

     cell1/cell2 = Inflow/Outflow (CashFlow) or Income/Expenses (Accounting); cell3 = Net flow
     (CashFlow, highlighted) or Transfer (Accounting, plain, hidden when the active filter
     excludes transfers) — see widget_net_worth_card.xml's header comment for the full
     visibility/highlight rules, identical here. This replaces the old fixed 6-tile grid
     (Income/Expenses/Transfers/Inflow/Outflow/Net flow shown simultaneously) with 3
     perspective-relevant cells, matching the approved redesign. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NET WORTH"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/tv_nw_large_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="This month · Cash Flow view" />

        </LinearLayout>

        <!-- Inert "+" add-transaction button from the mockup — no PendingIntent wired
             (no deep-link infra exists for widgets yet). -->
        <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_add_button_bg"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

    </LinearLayout>

    <LinearLayout
            android:id="@+id/ll_nw_large_trend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <TextView
                android:id="@+id/tv_nw_large_net_worth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_on_surface"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="125,000.50 $" />

        <TextView
                android:id="@+id/tv_nw_large_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_netflow_pill_bg"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                tools:text="▲ +2.5%" />

    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

            <LinearLayout
                    android:id="@+id/ll_nw_cell1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/widget_metric_tile_bg"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                    <TextView
                            android:id="@+id/tv_nw_cell1_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/widget_on_surface_variant"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Inflow" />
                    <TextView
                            android:id="@+id/tv_nw_cell1_cmp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="▲6.0%" />
                </LinearLayout>

                <TextView
                        android:id="@+id/tv_nw_cell1_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/widget_on_surface"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="11,41,929.00 $" />

                <TextView
                        android:id="@+id/tv_nw_cell1_vs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="10sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="vs 10,82,350.00 $" />

            </LinearLayout>

            <LinearLayout
                    android:id="@+id/ll_nw_cell2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_metric_tile_bg"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                    <TextView
                            android:id="@+id/tv_nw_cell2_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/widget_on_surface_variant"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Outflow" />
                    <TextView
                            android:id="@+id/tv_nw_cell2_cmp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="▼1.4%" />
                </LinearLayout>

                <TextView
                        android:id="@+id/tv_nw_cell2_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/widget_on_surface"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="-5,38,215.00 $" />

                <TextView
                        android:id="@+id/tv_nw_cell2_vs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="10sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="vs 5,45,900.00 $" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
                android:id="@+id/ll_nw_cell3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/widget_netflow_pill_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                <TextView
                        android:id="@+id/tv_nw_cell3_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Net flow" />
                <TextView
                        android:id="@+id/tv_nw_cell3_cmp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/widget_accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="▲12.3%" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">
                <TextView
                        android:id="@+id/tv_nw_cell3_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_accent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="6,03,714.00 $" />
                <TextView
                        android:id="@+id/tv_nw_cell3_vs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/widget_accent"
                        android:textSize="10sp"
                        tools:text="vs 5,37,450.00 $" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <TextView
            android:id="@+id/tv_nw_large_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="8sp"
            tools:text="Amounts in USD · vs This month" />

</LinearLayout>
