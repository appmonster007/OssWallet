+package com.osscabinet.ossWallet.ui.screens.templates.entry.components
+
+import androidx.compose.foundation.BorderStroke
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.automirrored.rounded.Notes
+import androidx.compose.material.icons.rounded.*
+import androidx.compose.material3.*
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import com.osscabinet.ossWallet.domain.model.Account
+import com.osscabinet.ossWallet.domain.model.Category
+import com.osscabinet.ossWallet.ui.components.getAccountIconByName
+import com.osscabinet.ossWallet.ui.components.getIconByName
+import com.osscabinet.ossWallet.ui.components.entry.*
+
+@Composable
+fun TemplateFormBody(
+    name: String,
+    onNameChange: (String) -> Unit,
+    transactionType: Int,
+    onTypeSelected: (Int) -> Unit,
+    amount: String,
+    currency: String,
+    onAmountClick: () -> Unit,
+    selectedAccount: Account?,
+    onAccountClick: () -> Unit,
+    categoryName: String,
+    categoryObj: Category?,
+    onCategoryClick: () -> Unit,
+    payee: String,
+    onPayeeChange: (String) -> Unit,
+    uniquePayees: List<String>,
+    tags: List<String>,
+    onShowTagSheet: () -> Unit,
+    onRemoveTag: (String) -> Unit,
+    paymentMethod: String,
+    onPaymentMethodClick: () -> Unit,
+    location: String,
+    onLocationChange: (String) -> Unit,
+    note: String,
+    onNoteChange: (String) -> Unit,
+    uniqueNotes: List<String>,
+    modifier: Modifier = Modifier
+) {
+    Column(
+        modifier = modifier
+            .fillMaxSize()
+            .verticalScroll(rememberScrollState())
+            .padding(horizontal = 24.dp, vertical = 16.dp),
+        verticalArrangement = Arrangement.spacedBy(16.dp)
+    ) {
+        // Header Card: Type & Amount (Aeon Style)
+        Surface(
+            modifier = Modifier.fillMaxWidth(),
+            shape = RoundedCornerShape(32.dp),
+            color = MaterialTheme.colorScheme.surfaceContainerLow,
+            border = BorderStroke(0.5.dp, MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.15f)),
+            shadowElevation = 0.dp
+        ) {
+            Column(
+                modifier = Modifier.padding(24.dp),
+                horizontalAlignment = Alignment.CenterHorizontally
+            ) {
+                // Transaction Type Row
+                EntryTypeSelector(
+                    selectedType = transactionType,
+                    onTypeSelected = onTypeSelected,
+                    types = listOf(
+                        Triple(Icons.Rounded.Remove, "Expense", 0),
+                        Triple(Icons.Rounded.Add, "Income", 1)
+                    ),
+                    selectedColor = if (transactionType == 1) Color(0xFF004D40) else Color(0xFFB3261E),
+                    itemWidth = 120.dp
+                )
+
+                Spacer(modifier = Modifier.height(24.dp))
+
+                // Amount Area
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clickable(onClick = onAmountClick)
+                        .padding(vertical = 8.dp),
+                    contentAlignment = Alignment.Center
+                ) {
+                    Row(
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.Center
+                    ) {
+                        Text(
+                            text = currency,
+                            style = MaterialTheme.typography.labelLarge,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant
+                        )
+                        Spacer(modifier = Modifier.width(12.dp))
+                        Text(
+                            text = if (amount.isEmpty()) "0.00" else amount,
+                            style = MaterialTheme.typography.displayMedium.copy(
+                                fontWeight = FontWeight.Bold,
+                                letterSpacing = (-1).sp
+                            ),
+                            color = if (transactionType == 1) Color(0xFF004D40) else Color(0xFFB3261E)
+                        )
+                    }
+                }
+
+                HorizontalDivider(
+                    modifier = Modifier.padding(vertical = 12.dp),
+                    thickness = 0.5.dp,
+                    color = MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.15f)
+                )
+
+                EntryEditorialInput(
+                    value = name,
+                    onValueChange = onNameChange,
+                    label = "TEMPLATE NAME",
+                    icon = Icons.Rounded.Bookmark
+                )
+            }
+        }
+
+        Row(
+            modifier = Modifier.fillMaxWidth(),
