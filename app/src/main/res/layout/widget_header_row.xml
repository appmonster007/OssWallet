<?xml version="1.0" encoding="utf-8"?>
<!-- Shared widget header shell — the exact same label/settings/divider line used by EVERY
     widget's top row (Net Worth's widget_net_worth_row1.xml, Recent Activities'
     widget_recent_activities_main.xml), via <include>. root is <merge>, so including it inside
     a vertical LinearLayout drops the header line and its divider in as direct siblings of
     whatever else that layout adds below.

     This is what makes header height/padding/typography identical across widget types instead
     of each one hand-copying its own near-match that drifts (which is exactly what happened:
     Net Worth's header had no padding of its own while Recent Activities' did, so their header
     rows ended up different heights despite looking like "the same element").

     Requires an UNPADDED root — this fragment supplies its own paddingStart/End="12dp" (the
     widget's horizontal inset) and paddingTop/Bottom (10dp/8dp, doubling as the widget's top
     inset), and its divider needs no margin trick to reach the edges since there's no root
     padding left to fight. Every other row in a layout that includes this must pad itself
     horizontally too (see widget_net_worth_strip/card.xml's cell rows, or
     widget_recent_activities_item.xml's own 12dp side padding) — the root no longer provides it.

     tv_widget_header_title: label — @font/jetbrains_mono, 8sp bold, muted
     (widget_on_surface_variant), matching NetWorthCard.kt's sectionOverline/AppTextStyles usage.
     ll_widget_header_extra: empty slot a renderer can RemoteViews.addView() into for a
     widget-specific action (e.g. Recent Activities' "VIEW ALL" pill) — zero-sized and invisible
     when nothing is added, so widgets that don't need it (Net Worth) can just ignore it.
     iv_widget_header_settings: 10dp gear, bound to a PendingIntent by each widget's own
     renderer (opens that widget's own config activity for the current widgetId). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

        <TextView
                android:id="@+id/tv_widget_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="8sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="WIDGET TITLE" />

        <LinearLayout
                android:id="@+id/ll_widget_header_extra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        <ImageView
                android:id="@+id/iv_widget_header_settings"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/widget_ic_settings"
                android:contentDescription="@string/widget_net_worth_settings_description" />

    </LinearLayout>

    <FrameLayout
            android:id="@+id/v_widget_header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_outline" />

</merge>
