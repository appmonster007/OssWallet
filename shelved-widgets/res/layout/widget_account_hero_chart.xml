<?xml version="1.0" encoding="utf-8"?>
<!-- Account Hero widget — 4x2 tier, account-pinned. Colored dot + name + period, big balance +
     comparison pill, area/line sparkline bitmap below (WidgetLineAreaChartRenderer). Tap-inert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_inner_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/v_ah_dot" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_circle_badge" />
        <TextView android:id="@+id/tv_ah_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tv_ah_period" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/tv_ah_balance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_ah_comparison" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/widget_netflow_chip_bg" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:textColor="@color/widget_accent_teal" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <ImageView android:id="@+id/iv_ah_sparkline" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:scaleType="fitXY" />
</LinearLayout>
