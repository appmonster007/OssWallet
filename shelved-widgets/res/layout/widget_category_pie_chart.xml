<?xml version="1.0" encoding="utf-8"?>
<!-- Category Pie Chart widget — 4x2 tier. Donut bitmap (left, drawn by
     WidgetDonutChartRenderer) with a center-amount TextView overlay, legend list (right, up to
     5 rows: top 4 slices + one "Other" aggregate). Tap-inert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_inner_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <TextView android:id="@+id/tv_cpc_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">

        <FrameLayout android:layout_width="84dp" android:layout_height="84dp">
            <ImageView android:id="@+id/iv_cpc_donut" android:layout_width="match_parent" android:layout_height="match_parent" />
            <TextView android:id="@+id/tv_cpc_center_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:maxLines="2" />
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">

            <LinearLayout android:id="@+id/ll_cpc_legend1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/v_cpc_legend1_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_circle_badge" />
                <TextView android:id="@+id/tv_cpc_legend1_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_text_primary" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tv_cpc_legend1_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_cpc_legend2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/v_cpc_legend2_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_circle_badge" />
                <TextView android:id="@+id/tv_cpc_legend2_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_text_primary" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tv_cpc_legend2_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_cpc_legend3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/v_cpc_legend3_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_circle_badge" />
                <TextView android:id="@+id/tv_cpc_legend3_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_text_primary" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tv_cpc_legend3_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_cpc_legend4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="3dp">
                <ImageView android:id="@+id/v_cpc_legend4_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_circle_badge" />
                <TextView android:id="@+id/tv_cpc_legend4_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_text_primary" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tv_cpc_legend4_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_cpc_legend5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/v_cpc_legend5_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_circle_badge" />
                <TextView android:id="@+id/tv_cpc_legend5_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_text_primary" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/tv_cpc_legend5_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
