<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview for the Budgets widget picker thumbnail (android:previewLayout). Mirrors the
     real grouped-by-status list (BudgetsRemoteViewsFactory) — OVER BUDGET / ON TRACK section
     labels ahead of each group, no separate header block. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical">

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/widget_negative"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="OVER BUDGET" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/manrope" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" android:text="Dining out" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/manrope" android:textColor="@color/widget_negative" android:textSize="13sp" android:textStyle="bold" android:text="$12.00" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_on_surface_variant" android:textSize="8sp" android:text="OVER" />
        </LinearLayout>
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="5dp" android:max="100" android:progress="100" android:secondaryProgress="0" android:progressDrawable="@drawable/widget_budget_progress_over" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_on_surface_variant" android:textSize="8sp" android:text="$162.00 of $150.00" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_on_surface_variant" android:textSize="8sp" android:text="108% · Monthly" />
        </LinearLayout>
    </LinearLayout>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/widget_accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="ON TRACK" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/manrope" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" android:text="Groceries" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/manrope" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" android:text="$180.00" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_on_surface_variant" android:textSize="8sp" android:text="LEFT" />
        </LinearLayout>
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="5dp" android:max="100" android:progress="55" android:secondaryProgress="62" android:progressDrawable="@drawable/widget_budget_progress_ok" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_on_surface_variant" android:textSize="8sp" android:text="$220.00 of $400.00" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/jetbrains_mono" android:textColor="@color/widget_on_surface_variant" android:textSize="8sp" android:text="55% · Monthly" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
