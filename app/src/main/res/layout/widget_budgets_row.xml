<?xml version="1.0" encoding="utf-8"?>
<!-- One budget: name + the amount that matters, bar with pace tick, spent-of-limit line.
     Exactly one of the three bars is visible (BudgetsRemoteViewsRenderer) — a ProgressBar's colour
     comes from its drawable. The secondary progress of each bar is the pace tick.
     Each state has three bars: the system one (follows the device's night mode) and fixed light and
     dark ones for a widget forced to a theme, which a drawable cannot be switched to at runtime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/ll_budget_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

        <TextView
                android:id="@+id/tv_budget_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

        <TextView
                android:id="@+id/tv_budget_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/manrope"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

        <TextView
                android:id="@+id/tv_budget_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="8sp"
                android:maxLines="1" />
    </LinearLayout>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="5dp">

        <ProgressBar
                android:id="@+id/pb_budget_ok"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_budget_progress_ok" />
        <ProgressBar
                android:id="@+id/pb_budget_warn"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_budget_progress_warn" />
        <ProgressBar
                android:id="@+id/pb_budget_over"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_budget_progress_over" />
        <ProgressBar
                android:id="@+id/pb_budget_ok_light"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_budget_progress_ok_light" />
        <ProgressBar
                android:id="@+id/pb_budget_ok_dark"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_budget_progress_ok_dark" />
        <ProgressBar
                android:id="@+id/pb_budget_warn_light"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_budget_progress_warn_light" />
        <ProgressBar
                android:id="@+id/pb_budget_warn_dark"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_budget_progress_warn_dark" />
        <ProgressBar
                android:id="@+id/pb_budget_over_light"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_budget_progress_over_light" />
        <ProgressBar
                android:id="@+id/pb_budget_over_dark"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_budget_progress_over_dark" />
    </FrameLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/tv_budget_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />

        <TextView
                android:id="@+id/tv_budget_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/jetbrains_mono"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="8sp"
                android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
