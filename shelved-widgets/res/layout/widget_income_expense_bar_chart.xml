<?xml version="1.0" encoding="utf-8"?>
<!-- Income vs Expenses widget — 4x2 tier. Grouped bar bitmap (WidgetBarChartRenderer: income +
     expense bars per bucket, net-flow line truncated at today, future buckets faded). Tap-inert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_inner_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/tv_ieb_header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <View android:layout_width="7dp" android:layout_height="7dp" android:background="@color/widget_accent_teal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="In" android:textColor="@color/widget_text_muted" android:textSize="9sp" />
            <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginStart="8dp" android:background="@color/widget_series_amber" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="Out" android:textColor="@color/widget_text_muted" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView android:id="@+id/iv_ieb_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:scaleType="fitXY" />

    <TextView android:id="@+id/tv_ieb_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="9sp" />
</LinearLayout>
