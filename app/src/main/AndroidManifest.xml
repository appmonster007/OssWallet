                android:resource="@xml/category_treemap_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CashFlowComparisonWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cashflow_comparison_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CategorySpendingTrendWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
