                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/loans_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.AccountsWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/accounts_widget_info" />
        </receiver>

        <!-- Phase 3 widget rebuild (final phase): Account Hero / Income vs Expenses / Category
             Pie Chart / Category Treemap / Cash Flow Comparison / Category Spending Trend /
             Tag UpSet Plot homescreen widgets, same receiver shape as the eight above. -->
        <receiver
            android:name=".widget.AccountHeroWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/account_hero_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.IncomeExpenseBarWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/income_expense_bar_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CategoryPieChartWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/category_pie_chart_widget_info" />
