<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview (android:previewLayout, net_worth_widget_info.xml) — delegates straight to
     widget_net_worth_strip.xml (the widget's real default appearance: targetCellHeight="1"
     means the default placement is short enough to land in NetWorthRemoteViewsRenderer's strip
     branch) instead of a hand-copied mockup, so it can never drift from the real layout again.
     Android only supports one android:previewLayout per widget, so this always shows the strip
     tier regardless of what size the user actually places it at. -->
<include
        xmlns:android="http://schemas.android.com/apk/res/android"
        layout="@layout/widget_net_worth_strip"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
