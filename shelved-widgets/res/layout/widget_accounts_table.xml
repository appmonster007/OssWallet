<?xml version="1.0" encoding="utf-8"?>
<!-- Accounts widget — 4x3 tier, by displayOrder, up to 3 rows + a "Total" footer. Each row's
     sparkline is an AccountsRemoteViewsRenderer-drawn bitmap (WidgetSparklineRenderer). Row tap
     is inert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_inner_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Accounts" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_accounts_header_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="9sp" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout android:id="@+id/ll_account_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/v_account_row1_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_circle_badge" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tv_account_row1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_account_row1_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/iv_account_row1_sparkline" android:layout_width="56dp" android:layout_height="22dp" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/tv_account_row1_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout android:id="@+id/ll_account_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/v_account_row2_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_circle_badge" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tv_account_row2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_account_row2_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/iv_account_row2_sparkline" android:layout_width="56dp" android:layout_height="22dp" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/tv_account_row2_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout android:id="@+id/ll_account_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/v_account_row3_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_circle_badge" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tv_account_row3_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_account_row3_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_muted" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/iv_account_row3_sparkline" android:layout_width="56dp" android:layout_height="22dp" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/tv_account_row3_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/widget_divider_soft" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total" android:textColor="@color/widget_text_muted" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_accounts_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
