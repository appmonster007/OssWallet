<?xml version="1.0" encoding="utf-8"?>
<!-- Glass background for a widget forced to dark.
     A widget can't blur the wallpaper behind it (only windows can), so "glass" here is the frosted
     look without the blur: a translucent tint, a soft top sheen, and a hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_glass_radius" />
            <solid android:color="#C7131312" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_glass_radius" />
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_glass_radius" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
</layer-list>
