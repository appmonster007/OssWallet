<?xml version="1.0" encoding="utf-8"?>
<!-- "Large" (4x3) NetWorth widget tier, pushed via RemoteViews from
     NetWorthRemoteViewsRenderer.renderLarge() at minHeight >= LARGE_HEIGHT_DP (260dp).
     Everything the card tier has (amount, comparison pill, INC/EXP), plus a 3-column
     grid of 6 metric tiles and a footer caption. Net flow tile is highlighted. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Net worth"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/tv_nw_large_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_muted_alt"
            android:textSize="9sp"
            tools:text="This month · Cash Flow view" />

    <TextView
            android:id="@+id/tv_nw_large_net_worth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/widget_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="125,000.50 $" />

    <LinearLayout
            android:id="@+id/ll_nw_large_trend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_netflow_pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/tv_nw_large_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_accent_teal"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="▲ +2.5%" />

    </LinearLayout>

    <!-- INC / EXP summary row (same as card tier) -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/widget_income_color"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:id="@+id/tv_nw_large_inc"
                tools:text="INC 5,000.00 $" />

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/widget_expense_color"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:id="@+id/tv_nw_large_exp"
                tools:text="EXP 3,200.00 $" />

    </LinearLayout>

    <!-- 3-column x 2-row metric tile grid: Income, Expenses, Transfers / Inflow, Outflow, Net flow -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

            <LinearLayout
                    android:id="@+id/ll_nw_tile_income"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_metric_tile_bg"
                    android:orientation="vertical"
                    android:padding="6dp">
                <TextView android:id="@+id/tv_nw_tile_income_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Income" android:textColor="@color/widget_text_muted" android:textSize="7sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_nw_tile_income_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="5,000.00 $" />
                <TextView android:id="@+id/tv_nw_tile_income_cmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" tools:text="▲ +2.5%" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/ll_nw_tile_expense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_metric_tile_bg"
                    android:orientation="vertical"
                    android:padding="6dp">
                <TextView android:id="@+id/tv_nw_tile_expense_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expenses" android:textColor="@color/widget_text_muted" android:textSize="7sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_nw_tile_expense_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="3,200.00 $" />
                <TextView android:id="@+id/tv_nw_tile_expense_cmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" tools:text="▼ -1.0%" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/ll_nw_tile_transfer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_metric_tile_bg"
                    android:orientation="vertical"
                    android:padding="6dp">
                <TextView android:id="@+id/tv_nw_tile_transfer_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transfers" android:textColor="@color/widget_text_muted" android:textSize="7sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_nw_tile_transfer_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="500.00 $" />
                <TextView android:id="@+id/tv_nw_tile_transfer_cmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" tools:text="▲ +0.4%" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

            <LinearLayout
                    android:id="@+id/ll_nw_tile_inflow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_metric_tile_bg"
                    android:orientation="vertical"
                    android:padding="6dp">
                <TextView android:id="@+id/tv_nw_tile_inflow_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inflow" android:textColor="@color/widget_text_muted" android:textSize="7sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_nw_tile_inflow_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="5,500.00 $" />
                <TextView android:id="@+id/tv_nw_tile_inflow_cmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" tools:text="▲ +1.9%" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/ll_nw_tile_outflow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_metric_tile_bg"
                    android:orientation="vertical"
                    android:padding="6dp">
                <TextView android:id="@+id/tv_nw_tile_outflow_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Outflow" android:textColor="@color/widget_text_muted" android:textSize="7sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_nw_tile_outflow_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="3,700.00 $" />
                <TextView android:id="@+id/tv_nw_tile_outflow_cmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" tools:text="▼ -0.6%" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/ll_nw_tile_netflow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_netflow_pill_bg"
                    android:orientation="vertical"
                    android:padding="6dp">
                <TextView android:id="@+id/tv_nw_tile_netflow_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Net flow" android:textColor="@color/widget_accent_teal" android:textSize="7sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_nw_tile_netflow_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_accent_teal" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" tools:text="1,800.00 $" />
                <TextView android:id="@+id/tv_nw_tile_netflow_cmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" tools:text="▲ +3.1%" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <TextView
            android:id="@+id/tv_nw_large_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/widget_text_muted"
            android:textSize="8sp"
            tools:text="Amounts in USD · vs This month" />

</LinearLayout>
