<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Receipts are sealed with a device-bound Keystore key and would be unreadable if restored elsewhere. -->
    <exclude domain="file" path="attachments/" />
    <!-- The app's own backup files already carry everything they need to restore; letting the OS
         fold them into its own backup/transfer would duplicate (and, when unencrypted, expose)
         the same data outside this feature's own encryption and retention controls. -->
    <exclude domain="file" path="backups/" />
    <!-- Wrapped backup-encryption key material; useless off-device (the Keystore key that wraps it
         never leaves this device), but excluded anyway to minimize what leaves the device at all. -->
    <exclude domain="file" path="datastore/backup_vault.preferences_pb" />
</full-backup-content>