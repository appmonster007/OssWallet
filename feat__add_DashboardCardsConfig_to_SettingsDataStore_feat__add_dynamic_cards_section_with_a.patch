+import com.osscabinet.ossWallet.ui.components.AeonFlowSectionHeader
+
+/**
+ * Base interface for dashboard card components
+ * All dashboard cards should implement this interface for consistency
+ */
+interface DashboardCard {
+    val config: CardConfig
+    
+    @Composable
+    fun Content()
+}
+
+/**
+ * Common card wrapper that provides consistent styling and header structure
+ * All dashboard cards should use this wrapper for consistent design
+ */
+@Composable
+fun DashboardCardWrapper(
+    config: CardConfig,
+    modifier: Modifier = Modifier,
+    headerModifier: Modifier = Modifier,
+    onSettingsClick: () -> Unit = {},
+    onRemoveClick: (() -> Unit)? = null,
+    timelineLabel: String? = null,
+    content: @Composable () -> Unit
+) {
+    Card(
+        modifier = modifier,
+        shape = MaterialTheme.shapes.large,
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
+        border = BorderStroke(
+            1.dp,
+            MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.5f)
+        )
+    ) {
+        Column(
+            modifier = Modifier.padding(12.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp)
+        ) {
+            AeonFlowSectionHeader(
+                title = config.title,
+                modifier = headerModifier,
+                trailing = {
+                    Row(
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(8.dp)
+                    ) {
+                        timelineLabel?.let { label ->
+                            Text(
+                                text = label.uppercase(),
+                                style = MaterialTheme.typography.labelSmall.copy(
+                                    fontWeight = FontWeight.Bold,
+                                    letterSpacing = 0.5.sp,
+                                    fontSize = 10.sp
+                                ),
+                                color = MaterialTheme.colorScheme.primary.copy(alpha = 0.6f)
+                            )
+                        }
+                        if (onRemoveClick != null) {
+                            IconButton(
+                                onClick = onRemoveClick,
+                                modifier = Modifier.size(24.dp)
+                            ) {
+                                Icon(
+                                    Icons.Default.Close,
+                                    contentDescription = "Remove card",
+                                    tint = MaterialTheme.colorScheme.error
+                                )
+                            }
+                        }
+                        IconButton(
+                            onClick = onSettingsClick,
+                            modifier = Modifier.size(24.dp)
+                        ) {
+                            Icon(
+                                Icons.Default.MoreHoriz,
+                                contentDescription = "Settings",
+                                tint = MaterialTheme.colorScheme.primary
+                            )
+                        }
+                    }
+                }
+            )
+            
+            content()
+        }
+    }
+}
