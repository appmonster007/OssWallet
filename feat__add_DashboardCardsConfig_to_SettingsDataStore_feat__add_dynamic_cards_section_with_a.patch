+package com.osscabinet.ossWallet.ui.dashboard
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.sp
+import com.osscabinet.ossWallet.domain.model.Account
+import com.osscabinet.ossWallet.domain.model.Budget
+import com.osscabinet.ossWallet.domain.usecase.AccountSummaryItem
+import com.osscabinet.ossWallet.domain.usecase.CashFlowResult
+import com.osscabinet.ossWallet.domain.usecase.CurrencyAggregationItem
+import com.osscabinet.ossWallet.domain.model.settings.AccountsCardConfig
+import com.osscabinet.ossWallet.domain.model.settings.BudgetsCardConfig
+import com.osscabinet.ossWallet.domain.model.settings.CashFlowCardConfig
+import com.osscabinet.ossWallet.domain.model.settings.CardConfig
+import com.osscabinet.ossWallet.domain.model.settings.CurrencyBalancesCardConfig
+import com.osscabinet.ossWallet.domain.model.settings.NetWorthCardConfig
+import com.osscabinet.ossWallet.domain.model.timeline.TimelineRange
+import com.osscabinet.ossWallet.ui.dashboard.components.AccountsCard
+import com.osscabinet.ossWallet.ui.dashboard.components.BudgetsCard
+import com.osscabinet.ossWallet.ui.dashboard.components.CashFlowCard
+import com.osscabinet.ossWallet.ui.dashboard.components.CurrencyBalancesCard
+import com.osscabinet.ossWallet.ui.viewmodel.NetWorthUiState
+import java.math.BigDecimal
+
+/**
+ * Renders a dashboard card based on its configuration type
+ * This acts as an adapter between the new CardConfig system and existing card components
+ */
+@Composable
+fun CardRenderer(
+    config: CardConfig,
+    data: DashboardCardData,
+    modifier: Modifier = Modifier,
+    onConfigUpdate: (CardConfig) -> Unit = {},
+    onRemove: () -> Unit = {}
+) {
+    when (config) {
+        is NetWorthCardConfig -> NetWorthCardRenderer(config, data, modifier, onConfigUpdate, onRemove)
+        is CurrencyBalancesCardConfig -> CurrencyBalancesCardRenderer(config, data, modifier, onConfigUpdate, onRemove)
+        is CashFlowCardConfig -> CashFlowCardRenderer(config, data, modifier, onConfigUpdate, onRemove)
+        is AccountsCardConfig -> AccountsCardRenderer(config, data, modifier, onConfigUpdate, onRemove)
+        is BudgetsCardConfig -> BudgetsCardRenderer(config, data, modifier, onConfigUpdate, onRemove)
+    }
+}
+
+/**
+ * Data class containing all the data needed to render dashboard cards
+ */
+data class DashboardCardData(
+    val netWorthUiState: NetWorthUiState? = null,
+    val currencyTotals: List<CurrencyAggregationItem>? = null,
+    val cashFlowResult: CashFlowResult? = null,
+    val accounts: List<Account>? = null,
+    val accountStats: Map<String, AccountSummaryItem>? = null,
+    val budgets: List<Budget>? = null,
+    val baseCurrency: String = "USD",
+    val precision: Int = 2,
+    val exchangeRates: Map<String, BigDecimal> = emptyMap()
+)
+
+@Composable
+private fun NetWorthCardRenderer(
+    config: NetWorthCardConfig,
+    data: DashboardCardData,
+    modifier: Modifier,
+    onConfigUpdate: (CardConfig) -> Unit,
+    onRemove: () -> Unit
+) {
+    val timelineLabel = getTimelineLabel(config.timelineRange)
+    
+    com.osscabinet.ossWallet.ui.dashboard.components.DashboardCardWrapper(
+        config = config,
+        modifier = modifier,
+        onRemoveClick = onRemove,
+        timelineLabel = timelineLabel
+    ) {
+        when (val state = data.netWorthUiState) {
+            is NetWorthUiState.Loading -> {
+                Text("Loading...")
+            }
+            is NetWorthUiState.Success -> {
+                NetWorthCardContent(
+                    netWorth = state.netWorth,
+                    netIncome = state.netIncome,
+                    netExpense = state.netExpense,
+                    baseCurrency = state.baseCurrency,
+                    precision = state.precision,
+                    fontSize = config.fontSize
+                )
+            }
+            is NetWorthUiState.Error -> {
+                Text("Error: ${state.message}")
+            }
+            null -> {
+                Text("No data")
+            }
+        }
+    }
+}
