<?xml version="1.0" encoding="utf-8"?>
<!-- Shortest NetWorth widget layout (minHeight < 110dp — true content minimum is ~40dp per the
     70dp*n-30dp cell formula), pushed via RemoteViews from NetWorthRemoteViewsRenderer. Just
     widget_net_worth_row1.xml (header + amount) — the exact same block every taller tier
     starts with, not a separately-styled "micro" header.

     Root padding (12dp, all sides) must match strip.xml/card.xml exactly — all three tiers
     share one frame, not three independently-tuned ones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:gravity="top"
        android:padding="12dp">

    <include layout="@layout/widget_net_worth_row1" />

</LinearLayout>
