<?xml version="1.0" encoding="utf-8"?>
<!-- Planned Payments widget — 4x3 tier, up to 4 rows. Confirm/Skip are real PendingIntents to
     PlannedPaymentsWidgetActionReceiver (see PlannedPaymentsRemoteViewsRenderer); row body tap
     is inert. Each row is written out explicitly (not <include>'d) since RemoteViews re-uses
     the SAME view ids on every include of one sub-layout, which would make per-row
     setOnClickPendingIntent calls collide. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_inner_surface"
        android:orientation="vertical"
        android:padding="12dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Planned payments"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        <TextView
                android:id="@+id/tv_pp_header_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout android:id="@+id/ll_pp_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <FrameLayout android:id="@+id/v_pp_row1_badge" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_metric_tile_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_pp_row1_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_pp_row1_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tv_pp_row1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_pp_row1_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/btn_pp_row1_skip" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/widget_pill_pending_bg" android:text="↷" android:textSize="14sp" android:textColor="@color/widget_text_muted" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/btn_pp_row1_confirm" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/widget_accent_pill_bg" android:text="✓" android:textSize="14sp" android:textColor="@android:color/white" android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout android:id="@+id/ll_pp_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <FrameLayout android:id="@+id/v_pp_row2_badge" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_metric_tile_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_pp_row2_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_pp_row2_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tv_pp_row2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_pp_row2_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/btn_pp_row2_skip" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/widget_pill_pending_bg" android:text="↷" android:textSize="14sp" android:textColor="@color/widget_text_muted" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/btn_pp_row2_confirm" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/widget_pill_pending_bg" android:text="✓" android:textSize="14sp" android:textColor="@color/widget_text_muted" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout android:id="@+id/ll_pp_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <FrameLayout android:id="@+id/v_pp_row3_badge" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_metric_tile_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_pp_row3_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_pp_row3_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tv_pp_row3_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_pp_row3_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/btn_pp_row3_skip" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/widget_pill_pending_bg" android:text="↷" android:textSize="14sp" android:textColor="@color/widget_text_muted" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/btn_pp_row3_confirm" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/widget_pill_pending_bg" android:text="✓" android:textSize="14sp" android:textColor="@color/widget_text_muted" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout android:id="@+id/ll_pp_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <FrameLayout android:id="@+id/v_pp_row4_badge" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_metric_tile_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_pp_row4_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_pp_row4_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tv_pp_row4_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_pp_row4_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/btn_pp_row4_skip" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/widget_pill_pending_bg" android:text="↷" android:textSize="14sp" android:textColor="@color/widget_text_muted" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/btn_pp_row4_confirm" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/widget_pill_pending_bg" android:text="✓" android:textSize="14sp" android:textColor="@color/widget_text_muted" />
    </LinearLayout>

</LinearLayout>
