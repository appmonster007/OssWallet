<?xml version="1.0" encoding="utf-8"?>
<!-- Recent Activities "compact" tier (4x2) — single-line rows: name + status/date text +
     amount only, no tags/account/avatar. Up to 3 row slots; unused rows GONE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_surface"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

    <TextView
            android:id="@+id/tv_rtc_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/no_recent_activities"
            android:textColor="@color/widget_subtle"
            android:textSize="10sp"
            android:visibility="gone" />

    <LinearLayout
            android:id="@+id/ll_rtc_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:baselineAligned="false">
        <TextView android:id="@+id/tv_rtc_row1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textColor="@color/widget_text_primary" android:textSize="10sp" tools:text="Food &amp; Drinks" />
        <TextView android:id="@+id/tv_rtc_row1_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="@color/widget_text_muted" android:textSize="8sp" tools:text="Today" />
        <TextView android:id="@+id/tv_rtc_row1_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="10sp" android:textStyle="bold" tools:text="-5.50" tools:textColor="@color/widget_expense_color" />
    </LinearLayout>

    <LinearLayout
            android:id="@+id/ll_rtc_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:baselineAligned="false">
        <TextView android:id="@+id/tv_rtc_row2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textColor="@color/widget_text_primary" android:textSize="10sp" tools:text="Salary" />
        <TextView android:id="@+id/tv_rtc_row2_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="@color/widget_text_muted" android:textSize="8sp" tools:text="Yesterday" />
        <TextView android:id="@+id/tv_rtc_row2_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="10sp" android:textStyle="bold" tools:text="+2,500.00" tools:textColor="@color/widget_income_color" />
    </LinearLayout>

    <LinearLayout
            android:id="@+id/ll_rtc_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:baselineAligned="false">
        <TextView android:id="@+id/tv_rtc_row3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textColor="@color/widget_text_primary" android:textSize="10sp" tools:text="Transport" />
        <TextView android:id="@+id/tv_rtc_row3_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="@color/widget_text_muted" android:textSize="8sp" tools:text="2 days ago" />
        <TextView android:id="@+id/tv_rtc_row3_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="10sp" android:textStyle="bold" tools:text="-15.00" tools:textColor="@color/widget_expense_color" />
    </LinearLayout>

</LinearLayout>
