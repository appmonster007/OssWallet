<?xml version="1.0" encoding="utf-8"?>
<!-- Dev-reference preview only — see widget_net_worth_preview_3x1.xml for the full explanation.
     3-column x 3-row grid cell (180dp x 180dp via 70dp*n-30dp). 180dp is >= STRIP_HEIGHT_DP
     (180dp), so this is the CARD tier — card is the capped ceiling (maxResizeHeight=180dp).
     Change the included layout below to re-check a different row count's tier instead of
     guessing: MICRO <110dp, STRIP 110-179dp, CARD >=180dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

    <include
            layout="@layout/widget_net_worth_card"
            android:layout_width="180dp"
            android:layout_height="180dp" />

</FrameLayout>
